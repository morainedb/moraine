diff --git a/src/include/storage/ducklake_transaction.hpp b/src/include/storage/ducklake_transaction.hpp
index e22ce1cd..abb264b6 100644
--- a/src/include/storage/ducklake_transaction.hpp
+++ b/src/include/storage/ducklake_transaction.hpp
@@ -180,6 +180,21 @@ struct DuckLakeRetryConfig {
 	static DuckLakeRetryConfig FromContext(ClientContext &context);
 };
 
+//! Names the context that owns the transaction whose metadata connection
+//! this is registered on. That connection is created by DuckLake and never
+//! handed out, so nothing outside can interrupt it; work blocking beneath it
+//! reads the owner's flag through this instead.
+class DuckLakeParentContextState : public ClientContextState {
+public:
+	static constexpr const char *KEY = "ducklake_parent_context";
+
+	explicit DuckLakeParentContextState(weak_ptr<ClientContext> parent_p) : parent(std::move(parent_p)) {
+	}
+
+	//! The context whose COMMIT is driving the metadata connection.
+	weak_ptr<ClientContext> parent;
+};
+
 class DuckLakeTransaction : public Transaction, public enable_shared_from_this<DuckLakeTransaction> {
 	friend class DuckLakeTransactionState;
 	friend class DuckLakeInitializer;
diff --git a/src/storage/ducklake_transaction.cpp b/src/storage/ducklake_transaction.cpp
index 9822d55d..267ab260 100644
--- a/src/storage/ducklake_transaction.cpp
+++ b/src/storage/ducklake_transaction.cpp
@@ -829,6 +829,13 @@ Connection &DuckLakeTransaction::GetConnection() {
 			// FIXME: sqlite_scanner's per-scan read connections deadlock against concurrent writers
 			connection->Query("SET sqlite_disable_multithreaded_scans=true");
 		}
+
+		// This connection is ours and is never handed out, so its own
+		// interrupt flag is the one nobody can set. Record the context whose
+		// COMMIT is driving it, so a metadata query that blocks in the
+		// catalog can be cancelled by interrupting that caller.
+		connection->context->registered_state->Insert(
+		    DuckLakeParentContextState::KEY, make_shared_ptr<DuckLakeParentContextState>(context));
 		connection->BeginTransaction();
 		connection->Query("SET current_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE'");
 	}
