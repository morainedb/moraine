diff --git a/src/storage/ducklake_transaction_state.cpp b/src/storage/ducklake_transaction_state.cpp
index d1460897..e6aa92a9 100644
--- a/src/storage/ducklake_transaction_state.cpp
+++ b/src/storage/ducklake_transaction_state.cpp
@@ -1990,6 +1990,16 @@ void DuckLakeTransactionState::Commit(DuckLakeSnapshot transaction_snapshot,
 			break;
 		} catch (std::exception &ex) {
 			ErrorData error(ex);
+			auto outcome = error.ExtraInfo().find("commit_outcome");
+			// COMMIT can discard extra fields while preserving the backend's fixed message.
+			bool outcome_unknown = (outcome != error.ExtraInfo().end() && outcome->second == "unknown") ||
+			                       StringUtil::Contains(error.RawMessage(), "moraine: commit outcome unknown;");
+			if (outcome_unknown) {
+				// The metadata commit may reference these files. Later rollback must retain them too.
+				local_changes.Clear();
+				context.try_rollback();
+				error.Throw("DuckLake commit outcome unknown; files retained for reconciliation. ");
+			}
 			// rollback if there is an active transaction
 			context.try_rollback();
 			retryable_metadata_error = retryable_metadata_error || context.is_retryable_metadata_error(error.Message());
