+#include "functions/ducklake_table_functions.hpp"
+#include "duckdb/planner/binder.hpp"
+#include "duckdb/common/enums/database_modification_type.hpp"
+#include "storage/ducklake_catalog.hpp"
+#include "storage/ducklake_schema_entry.hpp"
+#include "storage/ducklake_table_entry.hpp"
+#include "storage/ducklake_transaction.hpp"
+#include "storage/ducklake_delete.hpp"
+#include "storage/ducklake_delete_filter.hpp"
+#include "storage/ducklake_metadata_manager.hpp"
+
+namespace duckdb {
+
+struct DeletePositionsBindData : public TableFunctionData {
+	DeletePositionsBindData(DuckLakeCatalog &catalog_p, DuckLakeTableEntry &table_p)
+	    : catalog(catalog_p), table(table_p) {
+	}
+	DuckLakeCatalog &catalog;
+	DuckLakeTableEntry &table;
+	//! Requested positions per committed data file id
+	map<idx_t, set<idx_t>> file_positions;
+	//! Requested row ids of committed inlined rows
+	set<idx_t> inlined_rows;
+	//! The snapshot the caller resolved its positions against, if it says
+	optional_idx resolved_snapshot;
+};
+
+struct DeletePositionsState : public GlobalTableFunctionState {
+	bool finished = false;
+	idx_t MaxThreads() const override {
+		return 1;
+	}
+};
+
+static void ParseFilePositions(const Value &files, map<idx_t, set<idx_t>> &result) {
+	if (files.IsNull()) {
+		throw InvalidInputException("ducklake_delete_positions: `files` cannot be NULL");
+	}
+	if (ListValue::GetChildren(files).empty()) {
+		return;
+	}
+	auto &element_type = ListType::GetChildType(files.type());
+	if (element_type.id() != LogicalTypeId::STRUCT) {
+		throw InvalidInputException(
+		    "ducklake_delete_positions: each `files` entry must be STRUCT(data_file_id UBIGINT, positions UBIGINT[])");
+	}
+	optional_idx file_index;
+	optional_idx positions_index;
+	auto &children = StructType::GetChildTypes(element_type);
+	for (idx_t i = 0; i < children.size(); i++) {
+		auto name = StringUtil::Lower(children[i].first);
+		if (name == "data_file_id") {
+			file_index = i;
+		} else if (name == "positions") {
+			positions_index = i;
+		}
+	}
+	if (children.size() != 2 || !file_index.IsValid() || !positions_index.IsValid()) {
+		throw InvalidInputException(
+		    "ducklake_delete_positions: each `files` entry must be STRUCT(data_file_id UBIGINT, positions UBIGINT[])");
+	}
+	for (auto &entry : ListValue::GetChildren(files)) {
+		if (entry.IsNull()) {
+			throw InvalidInputException("ducklake_delete_positions: a `files` entry cannot be NULL");
+		}
+		auto &fields = StructValue::GetChildren(entry);
+		auto &file_value = fields[file_index.GetIndex()];
+		auto &positions_value = fields[positions_index.GetIndex()];
+		if (file_value.IsNull() || positions_value.IsNull()) {
+			throw InvalidInputException("ducklake_delete_positions: `data_file_id` and `positions` cannot be NULL");
+		}
+		if (positions_value.type().id() != LogicalTypeId::LIST) {
+			throw InvalidInputException("ducklake_delete_positions: `positions` must be a list");
+		}
+		auto &positions = result[file_value.DefaultCastAs(LogicalType::UBIGINT).GetValue<idx_t>()];
+		for (auto &position : ListValue::GetChildren(positions_value)) {
+			if (position.IsNull()) {
+				throw InvalidInputException("ducklake_delete_positions: a position cannot be NULL");
+			}
+			positions.insert(position.DefaultCastAs(LogicalType::UBIGINT).GetValue<idx_t>());
+		}
+	}
+}
+
+static unique_ptr<FunctionData> DeletePositionsBind(ClientContext &context, TableFunctionBindInput &input,
+                                                    vector<LogicalType> &types, vector<string> &names) {
+	auto &catalog = DuckLakeBaseMetadataFunction::GetCatalog(context, input.inputs[0]).Cast<DuckLakeCatalog>();
+	auto &table = catalog
+	                  .GetEntry<TableCatalogEntry>(context, input.inputs[1].GetValue<string>(),
+	                                               input.inputs[2].GetValue<string>(), OnEntryNotFound::THROW_EXCEPTION)
+	                  ->Cast<DuckLakeTableEntry>();
+	auto result = make_uniq<DeletePositionsBindData>(catalog, table);
+	ParseFilePositions(input.inputs[3], result->file_positions);
+	auto inlined = input.named_parameters.find("inlined_rows");
+	if (inlined != input.named_parameters.end() && !inlined->second.IsNull()) {
+		for (auto &row_id : ListValue::GetChildren(inlined->second)) {
+			if (row_id.IsNull()) {
+				throw InvalidInputException("ducklake_delete_positions: an inlined row id cannot be NULL");
+			}
+			result->inlined_rows.insert(row_id.DefaultCastAs(LogicalType::UBIGINT).GetValue<idx_t>());
+		}
+	}
+	auto resolved = input.named_parameters.find("snapshot");
+	if (resolved != input.named_parameters.end() && !resolved->second.IsNull()) {
+		result->resolved_snapshot = resolved->second.DefaultCastAs(LogicalType::UBIGINT).GetValue<idx_t>();
+	}
+	// The staged deletes belong to the executing transaction, so a prepared call binds again for each execution.
+	input.binder->SetAlwaysRequireRebind();
+	input.binder->GetStatementProperties().RegisterDBModify(catalog, context, DatabaseModificationType::DELETE_DATA);
+	types = {LogicalType::BIGINT, LogicalType::BIGINT, LogicalType::BIGINT};
+	names = {"file_rows_deleted", "inline_rows_deleted", "delete_files_written"};
+	return std::move(result);
+}
+
+static unique_ptr<GlobalTableFunctionState> DeletePositionsInit(ClientContext &, TableFunctionInitInput &) {
+	return make_uniq<DeletePositionsState>();
+}
+
+static string RowIdList(const set<idx_t> &rows) {
+	string result;
+	for (auto row_id : rows) {
+		if (!result.empty()) {
+			result += ", ";
+		}
+		result += to_string(row_id);
+	}
+	return result;
+}
+
+//! Stages deletes of committed inlined rows, resolving each row's inlined table from the metadata.
+static idx_t DeleteInlinedRows(DuckLakeTransaction &transaction, DuckLakeSnapshot snapshot,
+                               DuckLakeTableEntry &table, set<idx_t> remaining) {
+	idx_t deleted = 0;
+	auto table_id = table.GetTableId();
+	for (auto &inlined_table : table.GetInlinedDataTables()) {
+		if (remaining.empty()) {
+			break;
+		}
+		auto result = transaction.Query(
+		    snapshot, StringUtil::Format("SELECT row_id FROM {METADATA_CATALOG}.%s WHERE row_id IN (%s) AND "
+		                                 "{SNAPSHOT_ID} >= begin_snapshot AND ({SNAPSHOT_ID} < end_snapshot OR "
+		                                 "end_snapshot IS NULL)",
+		                                 inlined_table.table_name, RowIdList(remaining)));
+		if (result->HasError()) {
+			result->GetErrorObject().Throw();
+		}
+		set<idx_t> found;
+		for (auto &row : *result) {
+			found.insert(row.GetValue<idx_t>(0));
+		}
+		if (found.empty()) {
+			continue;
+		}
+		for (auto row_id : found) {
+			remaining.erase(row_id);
+		}
+		auto pending = transaction.GetInlinedDeletes(table_id, inlined_table.table_name);
+		set<idx_t> new_deletes;
+		for (auto row_id : found) {
+			if (!pending || !pending->rows.count(row_id)) {
+				new_deletes.insert(row_id);
+			}
+		}
+		deleted += new_deletes.size();
+		if (!new_deletes.empty()) {
+			transaction.AddNewInlinedDeletes(table_id, inlined_table.table_name, std::move(new_deletes));
+		}
+	}
+	if (!remaining.empty()) {
+		throw InvalidInputException("ducklake_delete_positions: inlined row %d is not visible in table \"%s\" at "
+		                            "this snapshot; only committed inlined rows can be deleted by row id",
+		                            *remaining.begin(), table.name);
+	}
+	return deleted;
+}
+
+//! Positions of `file_id` deleted through inlined file deletions, committed or pending in this transaction.
+static void AddInlinedFileDeletes(DuckLakeTransaction &transaction, DuckLakeSnapshot snapshot, TableIndex table,
+                                  idx_t file_id, set<idx_t> &positions) {
+	transaction.GetLocalInlinedFileDeletesForFile(table, file_id, positions);
+	auto name = transaction.GetMetadataManager().GetInlinedDeletionTableName(table, snapshot);
+	if (name.empty()) {
+		return;
+	}
+	auto result = transaction.Query(
+	    snapshot, StringUtil::Format(
+	                  "SELECT row_id FROM {METADATA_CATALOG}.%s WHERE file_id = %d AND begin_snapshot <= {SNAPSHOT_ID}",
+	                  name, file_id));
+	if (result->HasError()) {
+		result->GetErrorObject().Throw();
+	}
+	for (auto &row : *result) {
+		positions.insert(row.GetValue<idx_t>(0));
+	}
+}
+
+static void DeletePositionsExecute(ClientContext &context, TableFunctionInput &input, DataChunk &output) {
+	auto &state = input.global_state->Cast<DeletePositionsState>();
+	if (state.finished) {
+		return;
+	}
+	auto &data = input.bind_data->Cast<DeletePositionsBindData>();
+	auto &transaction = DuckLakeTransaction::Get(context, data.catalog);
+	auto snapshot = transaction.GetSnapshot();
+	auto table_id = data.table.GetTableId();
+	auto &schema = data.table.ParentSchema().Cast<DuckLakeSchemaEntry>();
+	if (data.catalog.WriteDeletionVectors(schema.GetSchemaId(), table_id)) {
+		throw InvalidInputException("ducklake_delete_positions: table \"%s\" is configured to write deletion vectors, "
+		                            "which this function does not support; use DELETE instead",
+		                            data.table.name);
+	}
+	if (table_id.IsTransactionLocal()) {
+		throw InvalidInputException("ducklake_delete_positions: table \"%s\" was created in this transaction; only "
+		                            "committed tables have addressable files",
+		                            data.table.name);
+	}
+	// Positions resolved against an older snapshot may name rows this transaction already sees deleted; a newer
+	// one only stages what this snapshot still holds, and a deletion in between surfaces as a commit conflict.
+	if (data.resolved_snapshot.IsValid() && data.resolved_snapshot.GetIndex() < snapshot.snapshot_id) {
+		throw TransactionException("ducklake_delete_positions: positions were resolved against snapshot %d, older "
+		                            "than snapshot %d this transaction reads; retry the statement",
+		                            data.resolved_snapshot.GetIndex(), snapshot.snapshot_id);
+	}
+
+	map<idx_t, DuckLakeFileListExtendedEntry> files;
+	if (!data.file_positions.empty()) {
+		for (auto &entry : transaction.GetMetadataManager().GetExtendedFilesForTable(data.table, snapshot)) {
+			if (entry.file_id.IsValid()) {
+				files.emplace(entry.file_id.index, std::move(entry));
+			}
+		}
+	}
+	idx_t threshold = data.catalog.DataInliningRowLimit(context, schema.GetSchemaId(), table_id);
+
+	idx_t file_rows = 0;
+	idx_t inline_rows = 0;
+	idx_t files_written = 0;
+	auto &fs = FileSystem::GetFileSystem(context);
+	try {
+		for (auto &request : data.file_positions) {
+			if (context.interrupted) {
+				throw InterruptException();
+			}
+			auto file_entry = files.find(request.first);
+			if (file_entry == files.end()) {
+				throw InvalidInputException("ducklake_delete_positions: data file %d is not part of table \"%s\" at "
+				                            "this snapshot",
+				                            request.first, data.table.name);
+			}
+			auto &file = file_entry->second;
+			if (transaction.FileIsDropped(file.file.path)) {
+				continue;
+			}
+			for (auto position : request.second) {
+				if (position >= file.row_count) {
+					throw InvalidInputException("ducklake_delete_positions: position %d is beyond the %d rows of data "
+					                            "file %d",
+					                            position, file.row_count, request.first);
+				}
+			}
+
+			// Positions the file already has deleted: its pending delete file if this transaction wrote one, else
+			// the committed delete file, plus inlined file deletions from both.
+			set<idx_t> positions;
+			if (transaction.HasLocalDeleteForFile(table_id, file.file.path)) {
+				DuckLakeFileData pending;
+				transaction.GetLocalDeleteForFile(table_id, file.file.path, pending);
+				auto scanned = DuckLakeDeleteFilter::ScanDeleteFile(context, pending);
+				positions.insert(scanned.deleted_rows.begin(), scanned.deleted_rows.end());
+			} else if (!file.delete_file.path.empty()) {
+				// A replaced delete file embeds per-position snapshots and keeps the earliest begin; only the
+				// positions deleted at this snapshot count as already gone.
+				auto scanned = DuckLakeDeleteFilter::ScanDeleteFile(context, file.delete_file, optional_idx(),
+				                                                    snapshot.snapshot_id);
+				positions.insert(scanned.deleted_rows.begin(), scanned.deleted_rows.end());
+			}
+			set<idx_t> inlined_positions;
+			AddInlinedFileDeletes(transaction, snapshot, table_id, request.first, inlined_positions);
+
+			set<idx_t> new_positions;
+			for (auto position : request.second) {
+				if (!inlined_positions.count(position) && !positions.count(position)) {
+					new_positions.insert(position);
+				}
+			}
+			if (new_positions.empty()) {
+				continue;
+			}
+			file_rows += new_positions.size();
+			if (threshold > 0 && new_positions.size() <= threshold) {
+				transaction.AddNewInlinedFileDeletes(table_id, request.first, std::move(new_positions));
+				continue;
+			}
+
+			positions.insert(new_positions.begin(), new_positions.end());
+			fs.CreateDirectoriesRecursive(data.table.DataPath());
+			WriteDeleteFileInput write {context,
+			                            transaction,
+			                            fs,
+			                            data.table.DataPath(),
+			                            data.catalog.GenerateEncryptionKey(context),
+			                            file.file.path,
+			                            std::move(positions),
+			                            DeleteFileSource::REGULAR};
+			auto written = DuckLakeDeleteFileWriter::WriteDeleteFile(context, write);
+			auto written_path = written.file_name;
+			try {
+				written.data_file_id = file.file_id;
+				if (file.delete_file_id.IsValid()) {
+					written.overwrites_existing_delete = true;
+					written.overwritten_delete_file.delete_file_id = file.delete_file_id;
+					written.overwritten_delete_file.path = file.delete_file.path;
+				}
+				vector<DuckLakeDeleteFile> delete_files;
+				delete_files.push_back(std::move(written));
+				transaction.AddDeletes(table_id, std::move(delete_files));
+			} catch (...) {
+				fs.TryRemoveFile(written_path);
+				throw;
+			}
+			files_written++;
+		}
+		if (!data.inlined_rows.empty()) {
+			inline_rows = DeleteInlinedRows(transaction, snapshot, data.table, data.inlined_rows);
+		}
+	} catch (std::exception &error) {
+		// A partially staged call must abort the surrounding transaction.
+		throw TransactionException("ducklake_delete_positions: %s", error.what());
+	}
+	output.SetValue(0, 0, Value::BIGINT(NumericCast<int64_t>(file_rows)));
+	output.SetValue(1, 0, Value::BIGINT(NumericCast<int64_t>(inline_rows)));
+	output.SetValue(2, 0, Value::BIGINT(NumericCast<int64_t>(files_written)));
+	output.SetCardinality(1);
+	state.finished = true;
+}
+
+DuckLakeDeletePositionsFunction::DuckLakeDeletePositionsFunction()
+    : TableFunction("ducklake_delete_positions",
+                    {LogicalType::VARCHAR, LogicalType::VARCHAR, LogicalType::VARCHAR, LogicalType::LIST(LogicalType::ANY)},
+                    DeletePositionsExecute, DeletePositionsBind, DeletePositionsInit) {
+	named_parameters["inlined_rows"] = LogicalType::LIST(LogicalType::UBIGINT);
+	named_parameters["snapshot"] = LogicalType::UBIGINT;
+}
+
+} // namespace duckdb
