index f5eef0f40f258d073cd4d8425faa2e2625cbbb4c..d61d9dbd97fee2caaae14ceedd72b59d7d0f462d 100644
--- a/src/storage/ducklake_transaction.cpp
+++ b/src/storage/ducklake_transaction.cpp
@@ -6,0 +7 @@
+#include "duckdb/common/multi_file/multi_file_reader.hpp"
@@ -1240,0 +1242,18 @@ DuckLakeFileInfo DuckLakeTransaction::BuildDataFileInfo(const DuckLakeDataFile &
+	auto row_id_field = FieldIndex(static_cast<idx_t>(MultiFileReader::ROW_ID_FIELD_ID));
+	if (file.row_count > 0 && row_id_start.IsValid() &&
+	    data_file.column_stats.find(row_id_field) == data_file.column_stats.end()) {
+		auto max_offset = file.row_count - 1;
+		auto min_row_id = row_id_start.GetIndex();
+		if (min_row_id <= NumericLimits<idx_t>::Maximum() - max_offset) {
+			DuckLakeColumnStats row_id_stats(LogicalType::BIGINT);
+			row_id_stats.min = to_string(min_row_id);
+			row_id_stats.max = to_string(min_row_id + max_offset);
+			row_id_stats.has_min = true;
+			row_id_stats.has_max = true;
+			row_id_stats.num_values = file.row_count;
+			row_id_stats.null_count = 0;
+			row_id_stats.has_num_values = true;
+			row_id_stats.has_null_count = true;
+			data_file.column_stats.emplace(row_id_field, std::move(row_id_stats));
+		}
+	}
