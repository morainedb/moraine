+	if (column_id == COLUMN_IDENTIFIER_ROW_ID) {
+		auto field_index = static_cast<idx_t>(MultiFileReader::ROW_ID_FIELD_ID);
+		ColumnFilterInfo filter_info_entry(field_index, LogicalType::BIGINT, std::move(filter));
+		pushdown_info.column_filters.emplace(field_index, std::move(filter_info_entry));
