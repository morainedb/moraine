+optional_idx ParquetFileScanner::FindColumnByFieldId(int32_t field_id) const {
+	auto &multi_file_data = bind_data->Cast<MultiFileBindData>();
+	if (!multi_file_data.initial_reader) {
+		return optional_idx();
+	}
+	auto &columns = multi_file_data.initial_reader->GetColumns();
+	for (idx_t i = 0; i < columns.size(); i++) {
+		auto &identifier = columns[i].identifier;
+		if (!identifier.IsNull() && identifier.type().id() == LogicalTypeId::INTEGER &&
+		    identifier.GetValue<int32_t>() == field_id) {
+			return i;
+		}
+	}
+	return optional_idx();
