diff --git a/test/sql/rowid/ducklake_row_id_file_pruning.test b/test/sql/rowid/ducklake_row_id_file_pruning.test
new file mode 100644
index 0000000000000000000000000000000000000000..9c87e00fa1648bfbafdff0d64fd2684a3c568bfb
--- /dev/null
+++ b/test/sql/rowid/ducklake_row_id_file_pruning.test
@@ -0,0 +1,160 @@
+# name: test/sql/rowid/ducklake_row_id_file_pruning.test
+# description: row-id statistics prune files without excluding files whose statistics are missing
+# group: [rowid]
+
+require ducklake
+
+require parquet
+
+test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db
+
+test-env DATA_PATH __TEST_DIR__
+
+statement ok
+ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_row_id_file_pruning', METADATA_CATALOG 'row_id_meta', DATA_INLINING_ROW_LIMIT 0)
+
+statement ok
+CREATE TABLE ducklake.dense(i INTEGER)
+
+statement ok
+INSERT INTO ducklake.dense SELECT i FROM range(3) t(i)
+
+statement ok
+INSERT INTO ducklake.dense SELECT i FROM range(3, 5) t(i)
+
+statement ok
+INSERT INTO ducklake.dense SELECT i FROM range(5, 9) t(i)
+
+query III
+SELECT data.record_count, stats.min_value, stats.max_value
+FROM row_id_meta.ducklake_data_file AS data
+JOIN row_id_meta.ducklake_file_column_stats AS stats USING (data_file_id, table_id)
+WHERE data.end_snapshot IS NULL
+  AND stats.column_id = 2147483540
+ORDER BY data.data_file_id
+----
+3	0	2
+2	3	4
+4	5	8
+
+query II
+EXPLAIN ANALYZE SELECT * FROM ducklake.dense WHERE rowid = 3
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 1.*
+
+query II
+EXPLAIN ANALYZE SELECT * FROM ducklake.dense WHERE rowid IN (1, 7)
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 2.*
+
+query II
+EXPLAIN ANALYZE
+SELECT data.*
+FROM ducklake.dense AS data
+JOIN (VALUES (1), (7)) AS hits(row_id)
+  ON data.rowid = hits.row_id
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 2.*
+
+statement ok
+DELETE FROM row_id_meta.ducklake_file_column_stats
+WHERE column_id = 2147483540
+  AND data_file_id = (
+    SELECT min(data_file_id)
+    FROM row_id_meta.ducklake_data_file
+    WHERE end_snapshot IS NULL
+  )
+
+query II
+SELECT rowid, i FROM ducklake.dense WHERE rowid = 0
+----
+0	0
+
+query II
+EXPLAIN ANALYZE SELECT * FROM ducklake.dense WHERE rowid = 999
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 1.*
+
+statement ok
+CREATE TABLE ducklake.flushed(i INTEGER)
+
+statement ok
+CALL ducklake.set_option('data_inlining_row_limit', 10, table_name => 'flushed')
+
+statement ok
+INSERT INTO ducklake.flushed VALUES (0), (1)
+
+statement ok
+CALL ducklake.set_option('data_inlining_row_limit', 0, table_name => 'flushed')
+
+statement ok
+INSERT INTO ducklake.flushed SELECT i FROM range(2, 22) t(i)
+
+statement ok
+CALL ducklake.set_option('data_inlining_row_limit', 10, table_name => 'flushed')
+
+statement ok
+INSERT INTO ducklake.flushed VALUES (22), (23)
+
+statement ok
+CALL ducklake_flush_inlined_data('ducklake')
+
+# The flushed file has four sparse row ids. Its Parquet max (23), not the
+# synthesized dense max (3), must survive into metadata.
+query III
+SELECT data.record_count, stats.min_value, stats.max_value
+FROM row_id_meta.ducklake_data_file AS data
+JOIN row_id_meta.ducklake_table AS tables USING (table_id)
+JOIN row_id_meta.ducklake_file_column_stats AS stats USING (data_file_id, table_id)
+WHERE tables.table_name = 'flushed'
+  AND data.end_snapshot IS NULL
+  AND data.record_count = 4
+  AND stats.column_id = 2147483540
+----
+4	0	23
+
+query II
+EXPLAIN ANALYZE SELECT * FROM ducklake.flushed WHERE rowid = 23
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 1.*
+
+query II
+SELECT rowid, i FROM ducklake.flushed WHERE rowid = 23
+----
+23	23
+
+statement ok
+CREATE TABLE ducklake.sparse(i INTEGER)
+
+statement ok
+INSERT INTO ducklake.sparse SELECT i FROM range(10) t(i)
+
+statement ok
+DELETE FROM ducklake.sparse WHERE i % 2 = 1
+
+query III
+SELECT table_name, files_processed, files_created
+FROM ducklake_rewrite_data_files('ducklake', 'sparse', delete_threshold => 0)
+----
+sparse	1	1
+
+query III
+SELECT data.record_count, stats.min_value, stats.max_value
+FROM row_id_meta.ducklake_data_file AS data
+JOIN row_id_meta.ducklake_table AS tables USING (table_id)
+JOIN row_id_meta.ducklake_file_column_stats AS stats USING (data_file_id, table_id)
+WHERE tables.table_name = 'sparse'
+  AND data.end_snapshot IS NULL
+  AND stats.column_id = 2147483540
+----
+5	0	8
+
+query II
+EXPLAIN ANALYZE SELECT * FROM ducklake.sparse WHERE rowid = 9
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 0.*
+
+query II
+SELECT rowid, i FROM ducklake.sparse WHERE rowid = 8
+----
+8	8
