--- a/src/storage/ducklake_multi_file_reader.cpp
+++ b/src/storage/ducklake_multi_file_reader.cpp
@@ -606,0 +607,14 @@ unique_ptr<Expression> DuckLakeMultiFileReader::GetVirtualColumnExpression(
+	if (column_id == COLUMN_IDENTIFIER_DATA_FILE_ID) {
+
+		// A physical file emits its persistent catalog id; inlined and
+		// transaction-local sources have none and emit NULL.
+		Value data_file_id(LogicalType::UBIGINT);
+		if (reader_data.file_to_be_opened.extended_info) {
+			auto &options = reader_data.file_to_be_opened.extended_info->options;
+			auto entry = options.find("data_file_id");
+			if (entry != options.end()) {
+				data_file_id = entry->second;
+			}
+		}
+		return make_uniq<BoundConstantExpression>(std::move(data_file_id));
+	}
