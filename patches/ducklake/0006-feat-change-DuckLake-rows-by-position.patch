+//===--------------------------------------------------------------------===//
+// ducklake_update_positions
+//===--------------------------------------------------------------------===//
+//! Runs after the replacement rows have been written: stages the positional deletes and reports both counts.
+class DuckLakeUpdatePositions : public PhysicalOperator {
+public:
+	static constexpr const PhysicalOperatorType TYPE = PhysicalOperatorType::EXTENSION;
+
+	DuckLakeUpdatePositions(PhysicalPlan &physical_plan, vector<LogicalType> types, DuckLakeCatalog &catalog,
+	                        DuckLakeTableEntry &table, PositionalDeletes request, PhysicalOperator &child)
+	    : PhysicalOperator(physical_plan, PhysicalOperatorType::EXTENSION, std::move(types), 1), catalog(catalog),
+	      table(table), request(std::move(request)) {
+		children.push_back(child);
+	}
+
+	DuckLakeCatalog &catalog;
+	DuckLakeTableEntry &table;
+	PositionalDeletes request;
+
+	OperatorResultType Execute(ExecutionContext &context, DataChunk &input, DataChunk &chunk, GlobalOperatorState &,
+	                           OperatorState &) const override {
+		if (input.size() == 0) {
+			return OperatorResultType::NEED_MORE_INPUT;
+		}
+		auto inserted = input.GetValue(0, 0).DefaultCastAs(LogicalType::BIGINT).GetValue<int64_t>();
+		auto staged = StagePositionalDeletes(context.client, catalog, table, request, "ducklake_update_positions");
+		chunk.SetCardinality(1);
+		chunk.SetValue(0, 0, Value::BIGINT(NumericCast<int64_t>(staged.file_rows)));
+		chunk.SetValue(1, 0, Value::BIGINT(NumericCast<int64_t>(staged.inline_rows)));
+		chunk.SetValue(2, 0, Value::BIGINT(NumericCast<int64_t>(staged.files_written)));
+		chunk.SetValue(3, 0, Value::BIGINT(inserted));
+		return OperatorResultType::NEED_MORE_INPUT;
+	}
+
+	bool ParallelOperator() const override {
+		return false;
+	}
+
+	string GetName() const override {
+		return "DUCKLAKE_UPDATE_POSITIONS";
+	}
+};
+
+class DuckLakeLogicalUpdatePositions : public LogicalExtensionOperator {
+public:
+	DuckLakeLogicalUpdatePositions(idx_t table_index, DuckLakeCatalog &catalog, DuckLakeTableEntry &table,
+	                               PositionalDeletes request)
+	    : table_index(table_index), catalog(catalog), table(table), request(std::move(request)) {
+	}
+
+	idx_t table_index;
+	DuckLakeCatalog &catalog;
+	DuckLakeTableEntry &table;
+	PositionalDeletes request;
+
+	//! Plans the replacement rows — the table's columns followed by their row ids — through the same operators an
+	//! UPDATE uses, so the rows keep their ids and inline, copy, and register as an update's would.
+	PhysicalOperator &CreatePlan(ClientContext &context, PhysicalPlanGenerator &planner) override {
+		auto &child = planner.CreatePlan(*children[0]);
+		DuckLakeCopyInput copy_input(context, table);
+		copy_input.virtual_columns = InsertVirtualColumns::WRITE_ROW_ID;
+
+		optional_ptr<PhysicalOperator> plan = &child;
+		optional_ptr<DuckLakeInlineData> inline_data;
+		idx_t data_inlining_row_limit = catalog.GetInliningLimit(context, table);
+		if (data_inlining_row_limit > 0) {
+			plan = planner.Make<DuckLakeInlineData>(*plan, data_inlining_row_limit);
+			inline_data = plan->Cast<DuckLakeInlineData>();
+		}
+		auto &physical_copy = DuckLakeInsert::PlanCopyForInsert(context, planner, copy_input, plan);
+		auto &insert = DuckLakeInsert::PlanInsert(context, planner, table, std::move(copy_input.encryption_key));
+		if (inline_data) {
+			inline_data->insert = insert.Cast<DuckLakeInsert>();
+		}
+		insert.children.push_back(physical_copy);
+		return planner.Make<DuckLakeUpdatePositions>(types, catalog, table, request, insert);
+	}
+
+	string GetName() const override {
+		return "DUCKLAKE_UPDATE_POSITIONS";
+	}
+
+	string GetExtensionName() const override {
+		return "ducklake";
+	}
+
+	vector<ColumnBinding> GetColumnBindings() override {
+		vector<ColumnBinding> result;
+		for (idx_t i = 0; i < 4; i++) {
+			result.emplace_back(table_index, i);
+		}
+		return result;
+	}
+
+	void ResolveTypes() override {
+		types = {LogicalType::BIGINT, LogicalType::BIGINT, LogicalType::BIGINT, LogicalType::BIGINT};
+	}
+};
+
+//! Binds `replacement` — a SELECT producing the table's columns followed by each row's id — casts it to the
+//! table's types, and plans it through the update path with the positional deletes staged once it has run.
+static unique_ptr<LogicalOperator> UpdatePositionsBind(ClientContext &context, TableFunctionBindInput &input,
+                                                       idx_t bind_index, vector<string> &return_names) {
+	auto &catalog = DuckLakeBaseMetadataFunction::GetCatalog(context, input.inputs[0]).Cast<DuckLakeCatalog>();
+	auto &table = LookupTable(context, catalog, input.inputs[1], input.inputs[2]);
+	auto request = ParsePositionalDeletes(input, "ducklake_update_positions");
+	if (input.inputs[4].IsNull()) {
+		throw InvalidInputException("ducklake_update_positions: `replacement` cannot be NULL");
+	}
+
+	Parser parser;
+	parser.ParseQuery(input.inputs[4].GetValue<string>());
+	if (parser.statements.size() != 1 || parser.statements[0]->type != StatementType::SELECT_STATEMENT) {
+		throw InvalidInputException("ducklake_update_positions: `replacement` must be a single SELECT statement");
+	}
+	auto binder = Binder::CreateBinder(context, input.binder.get());
+	auto bound = binder->Bind(*parser.statements[0]);
+
+	// The replacement's columns cast to the table's, with the row id last.
+	vector<LogicalType> target_types;
+	for (auto &column : table.GetColumns().Physical()) {
+		target_types.push_back(column.Type());
+	}
+	target_types.push_back(LogicalType::BIGINT);
+	if (bound.types.size() != target_types.size()) {
+		throw InvalidInputException("ducklake_update_positions: `replacement` must produce the %d columns of table "
+		                            "\"%s\" followed by row_id, got %d columns",
+		                            target_types.size() - 1, table.name, bound.types.size());
+	}
+	auto bindings = bound.plan->GetColumnBindings();
+	vector<unique_ptr<Expression>> casts;
+	for (idx_t i = 0; i < target_types.size(); i++) {
+		unique_ptr<Expression> column = make_uniq<BoundColumnRefExpression>(bound.types[i], bindings[i]);
+		casts.push_back(BoundCastExpression::AddCastToType(context, std::move(column), target_types[i]));
+	}
+	auto projection = make_uniq<LogicalProjection>(input.binder->GenerateTableIndex(), std::move(casts));
+	projection->children.push_back(std::move(bound.plan));
+
+	// The staged changes belong to the executing transaction, so a prepared call binds again for each execution.
+	input.binder->SetAlwaysRequireRebind();
+	input.binder->GetStatementProperties().RegisterDBModify(catalog, context, DatabaseModificationType::DELETE_DATA);
+	auto plan = make_uniq<DuckLakeLogicalUpdatePositions>(bind_index, catalog, table, std::move(request));
+	// Reference every replacement column, or the unused-column optimizer prunes the projection to a constant.
+	auto projected = projection->GetColumnBindings();
+	for (idx_t i = 0; i < target_types.size(); i++) {
+		plan->expressions.push_back(make_uniq<BoundColumnRefExpression>(target_types[i], projected[i]));
+	}
+	plan->children.push_back(std::move(projection));
+	return_names = {"file_rows_deleted", "inline_rows_deleted", "delete_files_written", "rows_inserted"};
+	return std::move(plan);
+}
+
+DuckLakeUpdatePositionsFunction::DuckLakeUpdatePositionsFunction()
+    : TableFunction("ducklake_update_positions",
+                    {LogicalType::VARCHAR, LogicalType::VARCHAR, LogicalType::VARCHAR,
+                     LogicalType::LIST(LogicalType::ANY), LogicalType::VARCHAR},
+                    nullptr, nullptr, nullptr) {
+	named_parameters["inlined_rows"] = LogicalType::LIST(LogicalType::UBIGINT);
+	named_parameters["snapshot"] = LogicalType::UBIGINT;
+	bind_operator = UpdatePositionsBind;
+}
