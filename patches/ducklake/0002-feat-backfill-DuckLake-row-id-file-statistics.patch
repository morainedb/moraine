+namespace duckdb {
+
+struct DuckLakeBackfillRowIdStatsBindData : public TableFunctionData {
+	DuckLakeBackfillRowIdStatsBindData(Catalog &catalog_p, string schema_name_p, string table_name_p,
+	                                   optional_idx max_files_p)
+	    : catalog(catalog_p), schema_name(std::move(schema_name_p)), table_name(std::move(table_name_p)),
+	      max_files(max_files_p) {
+	}
+
+	Catalog &catalog;
+	string schema_name;
+	string table_name;
+	optional_idx max_files;
+};
+
+struct DuckLakeBackfillRowIdStatsState : public GlobalTableFunctionState {
+	vector<vector<Value>> rows;
+	idx_t offset = 0;
+	bool backfilled = false;
+};
+
+static unique_ptr<FunctionData> DuckLakeBackfillRowIdStatsBind(ClientContext &context,
+	                                                           TableFunctionBindInput &input,
+	                                                           vector<LogicalType> &return_types,
+	                                                           vector<string> &names) {
+	auto &catalog = DuckLakeBaseMetadataFunction::GetCatalog(context, input.inputs[0]);
+	string schema_name;
+	string table_name;
+	optional_idx max_files;
+
+	auto schema_entry = input.named_parameters.find("schema");
+	if (schema_entry != input.named_parameters.end() && !schema_entry->second.IsNull()) {
+		schema_name = StringValue::Get(schema_entry->second);
+	}
+	auto table_entry = input.named_parameters.find("table_name");
+	if (table_entry != input.named_parameters.end() && !table_entry->second.IsNull()) {
+		table_name = StringValue::Get(table_entry->second);
+	}
+	auto max_files_entry = input.named_parameters.find("max_files");
+	if (max_files_entry != input.named_parameters.end()) {
+		if (max_files_entry->second.IsNull()) {
+			throw BinderException("The max_files option must be a non-null integer");
+		}
+		max_files = UBigIntValue::Get(max_files_entry->second);
+		if (max_files.GetIndex() == 0) {
+			throw BinderException("The max_files option must be greater than zero");
+		}
+	}
+
+	if (!table_name.empty()) {
+		catalog.GetEntry<TableCatalogEntry>(context, schema_name, table_name, OnEntryNotFound::THROW_EXCEPTION);
+	} else if (!schema_name.empty()) {
+		catalog.GetSchema(context, schema_name, OnEntryNotFound::THROW_EXCEPTION);
+	}
+
+	names.emplace_back("schema_name");
+	return_types.emplace_back(LogicalType::VARCHAR);
+	names.emplace_back("table_name");
+	return_types.emplace_back(LogicalType::VARCHAR);
+	names.emplace_back("files_backfilled");
+	return_types.emplace_back(LogicalType::UBIGINT);
+	names.emplace_back("files_remaining");
+	return_types.emplace_back(LogicalType::UBIGINT);
+	return make_uniq<DuckLakeBackfillRowIdStatsBindData>(catalog, std::move(schema_name), std::move(table_name),
+	                                                    max_files);
+}
+
+static unique_ptr<GlobalTableFunctionState> DuckLakeBackfillRowIdStatsInit(ClientContext &,
+	                                                                       TableFunctionInitInput &) {
+	return make_uniq<DuckLakeBackfillRowIdStatsState>();
+}
+
+static vector<reference<DuckLakeTableEntry>> GetBackfillTables(ClientContext &context,
+	                                                           const DuckLakeBackfillRowIdStatsBindData &data) {
+	auto &catalog = data.catalog.Cast<DuckLakeCatalog>();
+	vector<reference<DuckLakeTableEntry>> tables;
+	if (!data.table_name.empty()) {
+		auto entry = catalog.GetEntry<TableCatalogEntry>(context, data.schema_name, data.table_name,
+		                                               OnEntryNotFound::THROW_EXCEPTION);
+		tables.push_back(entry->Cast<DuckLakeTableEntry>());
+	} else {
+		vector<reference<SchemaCatalogEntry>> schemas;
+		if (data.schema_name.empty()) {
+			schemas = catalog.GetSchemas(context);
+		} else {
+			schemas.push_back(catalog.GetSchema(context, data.schema_name));
+		}
+		for (auto &schema : schemas) {
+			schema.get().Scan(context, CatalogType::TABLE_ENTRY, [&](CatalogEntry &entry) {
+				if (entry.type == CatalogType::TABLE_ENTRY) {
+					tables.push_back(entry.Cast<DuckLakeTableEntry>());
+				}
+			});
+		}
+	}
+	std::sort(tables.begin(), tables.end(), [](const reference<DuckLakeTableEntry> &left,
+	                                          const reference<DuckLakeTableEntry> &right) {
+		auto &left_table = left.get();
+		auto &right_table = right.get();
+		if (left_table.schema.name != right_table.schema.name) {
+			return left_table.schema.name < right_table.schema.name;
+		}
+		return left_table.name < right_table.name;
+	});
+	return tables;
+}
+
+static vector<DataFileIndex> GetFilesMissingRowIdStats(DuckLakeTransaction &transaction,
+	                                                   DuckLakeSnapshot snapshot, TableIndex table_id) {
+	auto row_id_field = static_cast<idx_t>(MultiFileReader::ROW_ID_FIELD_ID);
+	auto query = StringUtil::Format(R"(
+SELECT data.data_file_id
+FROM {METADATA_CATALOG}.ducklake_data_file AS data
+WHERE data.table_id = %d
+  AND data.record_count > 0
+  AND {SNAPSHOT_ID} >= data.begin_snapshot
+  AND ({SNAPSHOT_ID} < data.end_snapshot OR data.end_snapshot IS NULL)
+  AND NOT EXISTS (
+      SELECT 1
+      FROM {METADATA_CATALOG}.ducklake_file_column_stats AS stats
+      WHERE stats.table_id = data.table_id
+        AND stats.data_file_id = data.data_file_id
+        AND stats.column_id = %d
+        AND stats.min_value IS NOT NULL
+        AND stats.max_value IS NOT NULL
+  )
+ORDER BY data.data_file_id
+)",
+	                                table_id.index, row_id_field);
+	auto result = transaction.Query(snapshot, query);
+	if (result->HasError()) {
+		result->GetErrorObject().Throw("Failed to find DuckLake files missing row-ID statistics: ");
+	}
+
+	vector<DataFileIndex> missing;
+	for (auto &row : *result) {
+		missing.emplace_back(row.GetValue<idx_t>(0));
+	}
+	return missing;
+}
+
+static DuckLakeColumnStats DenseRowIdStats(const DuckLakeFileListExtendedEntry &file) {
+	if (!file.row_id_start.IsValid()) {
+		throw InvalidInputException("Cannot backfill row-ID statistics for dense file %s without row_id_start",
+		                            file.file.path);
+	}
+	auto max_offset = file.row_count - 1;
+	auto min_row_id = file.row_id_start.GetIndex();
+	if (min_row_id > NumericLimits<idx_t>::Maximum() - max_offset) {
+		throw InvalidInputException("Cannot backfill overflowing row-ID range for file %s", file.file.path);
+	}
+
+	DuckLakeColumnStats result(LogicalType::BIGINT);
+	result.min = to_string(min_row_id);
+	result.max = to_string(min_row_id + max_offset);
+	result.has_min = true;
+	result.has_max = true;
+	result.num_values = file.row_count;
+	result.null_count = 0;
+	result.has_num_values = true;
+	result.has_null_count = true;
+	return result;
+}
+
+static DuckLakeColumnStats ScanSparseRowIdStats(ClientContext &context, ParquetFileScanner &scanner,
+	                                             idx_t column_index,
+	                                             const DuckLakeFileListExtendedEntry &file) {
+	if (scanner.GetTypes()[column_index].id() != LogicalTypeId::BIGINT) {
+		throw InvalidInputException("Invalid row-ID column type in file %s: expected BIGINT, found %s", file.file.path,
+		                            scanner.GetTypes()[column_index].ToString());
+	}
+
+	DuckLakeColumnStats result(LogicalType::BIGINT);
+	auto footer_stats = scanner.GetStatistics(column_index);
+	if (footer_stats && !footer_stats->CanHaveNull() && NumericStats::HasMin(*footer_stats) &&
+	    NumericStats::HasMax(*footer_stats)) {
+		auto min_row_id = NumericStats::Min(*footer_stats).GetValue<int64_t>();
+		auto max_row_id = NumericStats::Max(*footer_stats).GetValue<int64_t>();
+		if (min_row_id < 0 || max_row_id < min_row_id) {
+			throw InvalidInputException("Invalid row-ID range in file %s", file.file.path);
+		}
+		result.min = to_string(min_row_id);
+		result.max = to_string(max_row_id);
+	} else {
+		scanner.SetColumnIds({column_index});
+		DataChunk chunk;
+		chunk.Initialize(context, {scanner.GetTypes()[column_index]});
+		idx_t scanned_rows = 0;
+		int64_t min_row_id = NumericLimits<int64_t>::Maximum();
+		int64_t max_row_id = NumericLimits<int64_t>::Minimum();
+		while (scanner.Scan(chunk)) {
+			UnifiedVectorFormat row_ids;
+			chunk.data[0].ToUnifiedFormat(chunk.size(), row_ids);
+			auto values = UnifiedVectorFormat::GetData<int64_t>(row_ids);
+			for (idx_t row_index = 0; row_index < chunk.size(); row_index++) {
+				auto value_index = row_ids.sel->get_index(row_index);
+				if (!row_ids.validity.RowIsValid(value_index)) {
+					throw InvalidInputException("Invalid NULL row ID in file %s", file.file.path);
+				}
+				if (values[value_index] < 0) {
+					throw InvalidInputException("Invalid negative row ID in file %s", file.file.path);
+				}
+				min_row_id = MinValue(min_row_id, values[value_index]);
+				max_row_id = MaxValue(max_row_id, values[value_index]);
+				scanned_rows++;
+			}
+		}
+		if (scanned_rows != file.row_count) {
+			throw InvalidInputException("Row count mismatch while backfilling file %s: expected %d, scanned %d",
+			                            file.file.path, file.row_count, scanned_rows);
+		}
+		result.min = to_string(min_row_id);
+		result.max = to_string(max_row_id);
+	}
+	result.has_min = true;
+	result.has_max = true;
+	result.num_values = file.row_count;
+	result.null_count = 0;
+	result.has_num_values = true;
+	result.has_null_count = true;
+	return result;
+}
+
+static DuckLakeColumnStats ReadRowIdStats(ClientContext &context, const DuckLakeFileListExtendedEntry &file) {
+	ParquetFileScanner scanner(context, file.file);
+	auto row_id_column = scanner.FindColumnByFieldId(MultiFileReader::ROW_ID_FIELD_ID);
+	if (!row_id_column.IsValid()) {
+		return DenseRowIdStats(file);
+	}
+	return ScanSparseRowIdStats(context, scanner, row_id_column.GetIndex(), file);
+}
+
+static void WriteRowIdStats(DuckLakeTransaction &transaction, DuckLakeSnapshot snapshot, TableIndex table_id,
+	                        DataFileIndex file_id, const DuckLakeColumnStats &stats) {
+	auto row_id_field = FieldIndex(static_cast<idx_t>(MultiFileReader::ROW_ID_FIELD_ID));
+	auto values = DuckLakeColumnStatsInfo::FromColumnStats(row_id_field, stats);
+	auto query = StringUtil::Format(R"(
+DELETE FROM {METADATA_CATALOG}.ducklake_file_column_stats
+WHERE table_id = %d AND data_file_id = %d AND column_id = %d;
+INSERT INTO {METADATA_CATALOG}.ducklake_file_column_stats
+SELECT %d, %d, %d, %s, %s, %s, %s, %s, %s, %s
+WHERE EXISTS (
+    SELECT 1
+    FROM {METADATA_CATALOG}.ducklake_data_file
+    WHERE table_id = %d
+      AND data_file_id = %d
+      AND {SNAPSHOT_ID} >= begin_snapshot
+      AND ({SNAPSHOT_ID} < end_snapshot OR end_snapshot IS NULL)
+)
+)",
+	                                table_id.index, file_id.index, row_id_field.index, file_id.index, table_id.index,
+	                                row_id_field.index, values.column_size_bytes, values.value_count, values.null_count,
+	                                values.min_val, values.max_val, values.contains_nan, values.extra_stats,
+	                                table_id.index, file_id.index);
+	auto result = transaction.Query(snapshot, query);
+	if (result->HasError()) {
+		result->GetErrorObject().Throw("Failed to write DuckLake row-ID statistics: ");
+	}
+}
+
+static void BackfillRowIdStats(ClientContext &context, const DuckLakeBackfillRowIdStatsBindData &data,
+	                           DuckLakeBackfillRowIdStatsState &state) {
+	auto &transaction = DuckLakeTransaction::Get(context, data.catalog);
+	auto snapshot = transaction.GetSnapshot();
+	auto &metadata_manager = transaction.GetMetadataManager();
+	auto tables = GetBackfillTables(context, data);
+	idx_t files_left = data.max_files.IsValid() ? data.max_files.GetIndex() : NumericLimits<idx_t>::Maximum();
+
+	for (auto &table_ref : tables) {
+		auto &table = table_ref.get();
+		if (table.GetTableId().IsTransactionLocal()) {
+			continue;
+		}
+		auto missing = GetFilesMissingRowIdStats(transaction, snapshot, table.GetTableId());
+		auto selected_count = MinValue<idx_t>(files_left, missing.size());
+		if (selected_count > 0) {
+			auto files = metadata_manager.GetExtendedFilesForTable(table, snapshot, nullptr);
+			unordered_map<idx_t, reference<DuckLakeFileListExtendedEntry>> files_by_id;
+			for (auto &file : files) {
+				files_by_id.emplace(file.file_id.index, file);
+			}
+			for (idx_t file_index = 0; file_index < selected_count; file_index++) {
+				auto entry = files_by_id.find(missing[file_index].index);
+				if (entry == files_by_id.end()) {
+					throw InternalException("Active DuckLake data file %d disappeared during row-ID-stat backfill",
+					                        missing[file_index].index);
+				}
+				auto stats = ReadRowIdStats(context, entry->second.get());
+				WriteRowIdStats(transaction, snapshot, table.GetTableId(), missing[file_index], stats);
+			}
+			files_left -= selected_count;
+		}
+
+		state.rows.push_back({Value(table.schema.name), Value(table.name), Value::UBIGINT(selected_count),
+		                      Value::UBIGINT(missing.size() - selected_count)});
+	}
+}
+
+static void DuckLakeBackfillRowIdStatsExecute(ClientContext &context, TableFunctionInput &input,
+	                                           DataChunk &output) {
+	auto &data = input.bind_data->Cast<DuckLakeBackfillRowIdStatsBindData>();
+	auto &state = input.global_state->Cast<DuckLakeBackfillRowIdStatsState>();
+	if (!state.backfilled) {
+		BackfillRowIdStats(context, data, state);
+		state.backfilled = true;
+	}
+
+	idx_t count = 0;
+	while (state.offset < state.rows.size() && count < STANDARD_VECTOR_SIZE) {
+		auto &row = state.rows[state.offset++];
+		for (idx_t column_index = 0; column_index < row.size(); column_index++) {
+			output.SetValue(column_index, count, row[column_index]);
+		}
+		count++;
+	}
+	output.SetCardinality(count);
+}
+
+DuckLakeBackfillRowIdStatsFunction::DuckLakeBackfillRowIdStatsFunction()
+	: TableFunction("ducklake_backfill_row_id_stats", {LogicalType::VARCHAR}, DuckLakeBackfillRowIdStatsExecute,
+	                DuckLakeBackfillRowIdStatsBind, DuckLakeBackfillRowIdStatsInit) {
+	named_parameters["schema"] = LogicalType::VARCHAR;
+	named_parameters["table_name"] = LogicalType::VARCHAR;
+	named_parameters["max_files"] = LogicalType::UBIGINT;
+}
+
+} // namespace duckdb
