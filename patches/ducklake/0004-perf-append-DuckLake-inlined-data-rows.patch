diff --git a/test/sql/data_inlining/data_inlining_appender.test b/test/sql/data_inlining/data_inlining_appender.test
new file mode 100644
index 00000000..b60df64d
--- /dev/null
+++ b/test/sql/data_inlining/data_inlining_appender.test
@@ -0,0 +1,66 @@
+# name: test/sql/data_inlining/data_inlining_appender.test
+# description: inlined rows written through the Appender API match the SQL path they replace
+# group: [data_inlining]
+
+require ducklake
+
+require parquet
+
+test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db
+
+test-env DATA_PATH __TEST_DIR__
+
+statement ok
+ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/data_inlining_appender', METADATA_CATALOG 'inlining_appender_meta', DATA_INLINING_ROW_LIMIT 5000)
+
+statement ok
+CREATE TABLE ducklake.t(a INTEGER, b VARCHAR, c DOUBLE, d INTEGER[])
+
+# The first insert creates the inlined table, so it still takes the SQL path.
+statement ok
+INSERT INTO ducklake.t SELECT i, 'x' || i, i * 1.5, [i, i + 1] FROM range(1000) t(i)
+
+# Every later insert appends into the table the first one created.
+statement ok
+INSERT INTO ducklake.t SELECT i, 'y' || i, i * 2.5, [i, i + 2] FROM range(1000, 3000) t(i)
+
+statement ok
+INSERT INTO ducklake.t VALUES (NULL, NULL, NULL, NULL)
+
+query IIII
+SELECT count(*), count(a), sum(a), max(d[2]) FROM ducklake.t
+----
+3001	3000	4498500	3001
+
+# Rows from both paths read back with their own values.
+query IIII
+SELECT a, b, c, d FROM ducklake.t WHERE a IN (0, 999, 1000, 2999) ORDER BY a
+----
+0	x0	0.0	[0, 1]
+999	x999	1498.5	[999, 1000]
+1000	y1000	2500.0	[1000, 1002]
+2999	y2999	7497.5	[2999, 3001]
+
+# Nothing was flushed to Parquet - all of it is still inlined.
+query I
+SELECT count(*) FROM ducklake_list_files('ducklake', 't')
+----
+0
+
+# Updating inlined rows preserves row ids through the appended data.
+statement ok
+UPDATE ducklake.t SET b = 'updated' WHERE a < 5
+
+statement ok
+DELETE FROM ducklake.t WHERE a BETWEEN 100 AND 199
+
+query II
+SELECT count(*), count(*) FILTER (WHERE b = 'updated') FROM ducklake.t
+----
+2901	5
+
+# Time travel still sees the pre-DML state.
+query I
+SELECT count(*) FROM ducklake.t AT (VERSION => 3)
+----
+3000
diff --git a/test/sql/data_inlining/inlining_append_retry.test b/test/sql/data_inlining/inlining_append_retry.test
new file mode 100644
index 00000000..8ea0f2e3
--- /dev/null
+++ b/test/sql/data_inlining/inlining_append_retry.test
@@ -0,0 +1,56 @@
+# name: test/sql/data_inlining/inlining_append_retry.test
+# description: a losing concurrent inlined insert retries without losing or duplicating appended rows
+# group: [data_inlining]
+
+require ducklake
+
+require parquet
+
+test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db
+
+test-env DATA_PATH __TEST_DIR__
+
+statement ok
+ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/inlining_append_retry', METADATA_CATALOG 'append_retry_meta', DATA_INLINING_ROW_LIMIT 5000)
+
+statement ok
+CREATE TABLE ducklake.t(a INTEGER, b VARCHAR)
+
+# Seed so the inlined table exists and both writers below take the appender path.
+statement ok
+INSERT INTO ducklake.t VALUES (-1, 'seed')
+
+statement ok con1
+BEGIN
+
+statement ok con2
+BEGIN
+
+statement ok con1
+INSERT INTO ducklake.t SELECT i, 'one' FROM range(1000) t(i)
+
+statement ok con2
+INSERT INTO ducklake.t SELECT i, 'two' FROM range(1000, 2000) t(i)
+
+statement ok con1
+COMMIT
+
+# con2 lost the race, so this commit retries; its appended rows must survive exactly once.
+statement ok con2
+COMMIT
+
+query III
+SELECT count(*), count(*) FILTER (WHERE b = 'one'), count(*) FILTER (WHERE b = 'two') FROM ducklake.t
+----
+2001	1000	1000
+
+# No row id was reused across the two writers.
+query I
+SELECT count(DISTINCT rowid) FROM ducklake.t
+----
+2001
+
+query I
+SELECT count(*) FROM ducklake_list_files('ducklake', 't')
+----
+0
