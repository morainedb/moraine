diff --git a/test/sql/rowid/ducklake_data_file_id.test b/test/sql/rowid/ducklake_data_file_id.test
new file mode 100644
index 00000000..73aa10d6
--- /dev/null
+++ b/test/sql/rowid/ducklake_data_file_id.test
@@ -0,0 +1,96 @@
+# name: test/sql/rowid/ducklake_data_file_id.test
+# description: the data_file_id virtual column names each row's file and prunes the file list
+# group: [rowid]
+
+require ducklake
+
+require parquet
+
+test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db
+
+test-env DATA_PATH __TEST_DIR__
+
+statement ok
+ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_data_file_id', METADATA_CATALOG 'data_file_id_meta', DATA_INLINING_ROW_LIMIT 0)
+
+statement ok
+CREATE TABLE ducklake.t(i INTEGER)
+
+statement ok
+INSERT INTO ducklake.t SELECT i FROM range(3) t(i)
+
+statement ok
+INSERT INTO ducklake.t SELECT i FROM range(100, 102) t(i)
+
+# Each row reports the file physically holding it.
+query II
+SELECT i, data_file_id FROM ducklake.t ORDER BY i
+----
+0	0
+1	0
+2	0
+100	1
+101	1
+
+# An equality predicate is answered by the file list, not by statistics.
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id = 1
+----
+2
+
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id = 0
+----
+3
+
+# An IN list admits both files.
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id IN (0, 1)
+----
+5
+
+# A predicate matching no file prunes everything.
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id = 999
+----
+0
+
+# Ranges push down too.
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id >= 1
+----
+2
+
+# Joining located rows restricts both the file list and the rows read.
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id = 1 AND i = 100
+----
+1
+
+statement ok
+CREATE TABLE ducklake.inlined(i INTEGER)
+
+statement ok
+CALL ducklake.set_option('data_inlining_row_limit', 10)
+
+statement ok
+INSERT INTO ducklake.inlined VALUES (1), (2)
+
+# An inlined row has no file, so its id is NULL rather than absent.
+query II
+SELECT i, data_file_id FROM ducklake.inlined ORDER BY i
+----
+1	NULL
+2	NULL
+
+# The null-safe shape a located join produces still prunes: no file carries a
+# NULL id, so that disjunct selects nothing rather than defeating the filter.
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id IN (1) OR data_file_id IS NULL
+----
+2
+
+query I
+SELECT count(*) FROM ducklake.t WHERE data_file_id IS NULL
+----
+0
