+static string GenerateDataFileIdFilter(const TableFilter &filter) {
+	switch (filter.filter_type) {
+	case TableFilterType::LEGACY_CONSTANT_COMPARISON: {
+		auto &constant_filter = filter.Cast<LegacyConstantFilter>();
+		if (constant_filter.constant.IsNull()) {
+			return string();
+		}
+		string comparison;
+		switch (constant_filter.comparison_type) {
+		case ExpressionType::COMPARE_EQUAL:
+			comparison = "=";
+			break;
+		case ExpressionType::COMPARE_NOTEQUAL:
+			comparison = "<>";
+			break;
+		case ExpressionType::COMPARE_LESSTHAN:
+			comparison = "<";
+			break;
+		case ExpressionType::COMPARE_LESSTHANOREQUALTO:
+			comparison = "<=";
+			break;
+		case ExpressionType::COMPARE_GREATERTHAN:
+			comparison = ">";
+			break;
+		case ExpressionType::COMPARE_GREATERTHANOREQUALTO:
+			comparison = ">=";
+			break;
+		default:
+			return string();
+		}
+		return StringUtil::Format("data.data_file_id %s %s", comparison, constant_filter.constant.ToString());
+	}
+	case TableFilterType::LEGACY_IS_NOT_NULL:
+		// Every row of the file list has an id, so this excludes nothing.
+		return string();
+	case TableFilterType::LEGACY_IS_NULL:
+		// No file carries a NULL id: a NULL names an inlined or
+		// transaction-local row, which the file list does not describe. As a
+		// disjunct beside a located id this contributes nothing, which is
+		// what lets the null-safe join shape prune at all.
+		return "FALSE";
+	case TableFilterType::LEGACY_CONJUNCTION_AND: {
+		auto &conjunction_and_filter = filter.Cast<LegacyConjunctionAndFilter>();
+		string result;
+		for (auto &child_filter : conjunction_and_filter.child_filters) {
+			auto child = GenerateDataFileIdFilter(*child_filter);
+			if (child.empty()) {
+				continue;
+			}
+			if (!result.empty()) {
+				result += " AND ";
+			}
+			result += "(" + child + ")";
+		}
+		return result;
+	}
+	case TableFilterType::LEGACY_CONJUNCTION_OR: {
+		auto &conjunction_or_filter = filter.Cast<LegacyConjunctionOrFilter>();
+		string result;
+		for (auto &child_filter : conjunction_or_filter.child_filters) {
+			auto child = GenerateDataFileIdFilter(*child_filter);
+			if (child.empty()) {
+				// One unrepresentable arm makes the whole disjunction
+				// unrepresentable: dropping it would prune a file the
+				// filter admits.
+				return string();
+			}
+			if (!result.empty()) {
+				result += " OR ";
+			}
+			result += "(" + child + ")";
+		}
+		return result;
+	}
+	case TableFilterType::LEGACY_OPTIONAL_FILTER: {
+		auto &optional_filter = filter.Cast<LegacyOptionalFilter>();
+		if (!optional_filter.child_filter) {
+			return string();
+		}
+		return GenerateDataFileIdFilter(*optional_filter.child_filter);
+	}
+	case TableFilterType::LEGACY_IN_FILTER: {
+		auto &in_filter = filter.Cast<LegacyInFilter>();
+		string in_list;
+		for (auto &value : in_filter.values) {
+			if (value.IsNull()) {
+				return string();
+			}
+			if (!in_list.empty()) {
+				in_list += ", ";
+			}
+			in_list += value.ToString();
+		}
+		if (in_list.empty()) {
+			return string();
+		}
+		return StringUtil::Format("data.data_file_id IN (%s)", in_list);
+	}
+	default:
+		// An unrepresentable filter prunes nothing rather than guessing.
+		return string();
+	}
+}
