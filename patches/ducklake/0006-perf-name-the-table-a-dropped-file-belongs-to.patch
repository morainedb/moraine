-string DuckLakeMetadataManager::DropDataFiles(const set<DataFileIndex> &dropped_files) {
-	return FlushDrop("ducklake_data_file", "data_file_id", dropped_files);
+string DuckLakeMetadataManager::DropDataFiles(const set<DataFileIndex> &dropped_files, optional_idx table_id) {
+	if (!table_id.IsValid()) {
+		return FlushDrop("ducklake_data_file", "data_file_id", dropped_files);
+	}
+	if (dropped_files.empty()) {
+		return {};
+	}
+	// Naming the table is redundant against the id list, which already
+	// identifies the rows. It is there for the metadata catalog: a catalog
+	// that narrows a scan by table can serve this update one table's files
+	// instead of every file in the lake.
+	auto dropped_id_list = GenerateIDList(dropped_files);
+	return StringUtil::Format(
+	    R"(UPDATE {METADATA_CATALOG}.ducklake_data_file SET end_snapshot = {SNAPSHOT_ID} WHERE table_id = %d AND end_snapshot IS NULL AND data_file_id IN (%s);)",
+	    table_id.GetIndex(), dropped_id_list);
 }
 
