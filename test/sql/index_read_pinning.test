# name: test/sql/index_read_pinning.test
# group: [moraine]

require-env MORAINE_DUCKDB_EXT

require-env MORAINE_EXTENSION_DIR

statement ok
SET threads=1;

statement ok
SET extension_directory='{MORAINE_EXTENSION_DIR}';

statement ok
LOAD parquet;

statement ok
LOAD '{MORAINE_DUCKDB_EXT}';

statement ok
ATTACH 'ducklake:moraine:{TEST_DIR}/index-pins-store' AS indexed (DATA_PATH '{TEST_DIR}/index-pins-data/', META_DATA_PATH '{TEST_DIR}/index-pins-data/', DATA_INLINING_ROW_LIMIT 100);

statement ok
CREATE TABLE indexed.main.t(a BIGINT);

statement ok
INSERT INTO indexed.main.t VALUES (1);

statement ok
CREATE INDEX by_a ON indexed.main.t(a);

statement ok reader
PREPARE probe AS SELECT count(*) FROM indexed.main.t data JOIN moraine_index_lookup('indexed','main','t','by_a',1) hits ON data.rowid=hits.row_id AND data.data_file_id IS NOT DISTINCT FROM hits.data_file_id;

statement ok reader
BEGIN;

query I reader
EXECUTE probe;
----
1

statement ok writer
INSERT INTO indexed.main.t VALUES (1);

# The second execution and DuckLake scan retain the first execution's view.
query I reader
EXECUTE probe;
----
1

statement ok writer
CALL ducklake_flush_inlined_data('indexed');

# Moving rows to a file must not change the old transaction's inline reads.
query I reader
EXECUTE probe;
----
1

statement ok reader
ROLLBACK;

query I reader
EXECUTE probe;
----
2

statement ok writer
DROP INDEX indexed.main.by_a;

statement error reader
EXECUTE probe;
----
by_a

statement ok writer
CREATE INDEX by_a ON indexed.main.t(a);

query I reader
EXECUTE probe;
----
2

statement ok reader
DEALLOCATE probe;

# A certified DELETE must use its transaction's index view after another
# connection changes the indexed key, then conflict instead of losing that write.
statement ok
CREATE TABLE indexed.main.deletions AS SELECT (i*7919)%100000 AS a, repeat(md5(i::VARCHAR),6) AS b FROM range(100000) r(i);

statement ok
CREATE UNIQUE INDEX by_deletion_a ON indexed.main.deletions(a);

query III
SELECT missing, dead, mismatched FROM moraine_index_verify('indexed','main','deletions','by_deletion_a');
----
0	0	0

statement ok reader
BEGIN;

query I reader
SELECT count(*) FROM indexed.main.deletions WHERE a = 30001;
----
1

statement ok writer
UPDATE indexed.main.deletions SET a = 200000 WHERE a = 30001;

statement ok reader
DELETE FROM indexed.main.deletions WHERE a = 30001;

query I reader
SELECT count(*) FROM indexed.main.deletions WHERE a = 30001;
----
0

statement error reader
COMMIT;
----
<REGEX>:.*(Conflict|conflict|TransactionContext Error).*

query I
SELECT count(*) FROM indexed.main.deletions WHERE a = 200000;
----
1

query III
SELECT missing, dead, mismatched FROM moraine_index_verify('indexed','main','deletions','by_deletion_a');
----
0	0	0
