# name: test/sql/metadata_rowid_resolution.test
# group: [moraine]
#
# A metadata DELETE resolves every row id against the rows its own scan
# emitted them for, for both kinds a scan narrows by `table_id`.
#
# A scan narrowed by `table_id` materializes just that table's run. If the
# write resolving its row ids materializes the table a second time, nothing
# makes the two lists the same: a commit landing between them adds rows
# ahead of the narrowed run, and the same positions then name rows of
# another table entirely — deleted with a correct-looking row count.
#
# Two connections over one instance are the only way to commit under an
# open reader, which is what this runner gives and the CLI cannot.
#
# Skipped unless the packaged Moraine extension is named in the
# environment; `cargo xtask e2e` supplies it.

require-env MORAINE_DUCKDB_EXT

require-env MORAINE_EXTENSION_DIR

# As in commit_concurrency.test: pin one thread so the connections, not the
# scheduler, are the concurrency.
statement ok
SET threads=1;

statement ok
SET extension_directory='${MORAINE_EXTENSION_DIR}';

statement ok
INSTALL parquet;

statement ok
LOAD parquet;

# Moraine must be registered before DuckLake opens the metadata catalog.
statement ok
LOAD '${MORAINE_DUCKDB_EXT}';

# Every insert writes a Parquet file, so every insert carries statistics.
statement ok
ATTACH 'ducklake:moraine:__TEST_DIR__/rowid-store' AS lake (
  DATA_PATH '__TEST_DIR__/rowid-data/',
  DATA_INLINING_ROW_LIMIT 0
);

statement ok
CREATE TABLE lake.main.t1(a BIGINT, b BIGINT);

statement ok
CREATE TABLE lake.main.t2(a BIGINT, b BIGINT);

statement ok
CREATE TABLE lake.main.t3(a BIGINT, b BIGINT);

statement ok
INSERT INTO lake.main.t1 VALUES (1, 1), (2, 2);

statement ok
INSERT INTO lake.main.t2 VALUES (3, 3), (4, 4);

statement ok
INSERT INTO lake.main.t3 VALUES (5, 5), (6, 6);

# Statistics are keyed table-major, so t1's rows precede t2's and t2's
# precede t3's. The DELETE below names t2 by the literal its pushdown needs
# to narrow a scan at all, so the ids are pinned here rather than looked up.
query IT
SELECT table_id, table_name
FROM __ducklake_metadata_lake.ducklake_table
ORDER BY table_id;
----
1	t1
2	t2
3	t3

statement ok con1
BEGIN;

# con1's first read materializes the whole table for its transaction.
statement ok con1
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_file_column_stats;

# A commit under con1, adding statistics rows ahead of t2's run. A write
# resolving row ids through a second materialization would find that run
# moved and take rows past its end.
statement ok con2
INSERT INTO lake.main.t1 VALUES (7, 7);

statement ok
SET VARIABLE t1_stats = (
  SELECT count(*) FROM __ducklake_metadata_lake.ducklake_file_column_stats
  WHERE table_id = 1
);

statement ok
SET VARIABLE t3_stats = (
  SELECT count(*) FROM __ducklake_metadata_lake.ducklake_file_column_stats
  WHERE table_id = 3
);

statement ok con1
DELETE FROM __ducklake_metadata_lake.ducklake_file_column_stats WHERE table_id = 2;

statement ok con1
COMMIT;

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_file_column_stats
WHERE table_id = 2;
----
0

# Neither neighbour lost a row: the deleted positions named t2's rows in
# the list the scan built, and nothing else.
query II
SELECT (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_file_column_stats
        WHERE table_id = 1) = getvariable('t1_stats'),
       (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_file_column_stats
        WHERE table_id = 3) = getvariable('t3_stats');
----
true	true

# The tables themselves still read, statistics being metadata: a lost row
# would not be visible here, which is why the counts above are the assertion.
query III
SELECT (SELECT count(*) FROM lake.main.t1),
       (SELECT count(*) FROM lake.main.t2),
       (SELECT count(*) FROM lake.main.t3);
----
3	2	2

# The same property for `ducklake_data_file`, the other kind a scan narrows
# by `table_id`. Its rows carry the file registrations, so a row resolved
# against the wrong list unregisters another table's data.

statement ok con1
BEGIN;

statement ok con1
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file;

# A commit under con1, adding a file row ahead of t2's run.
statement ok con2
INSERT INTO lake.main.t1 VALUES (8, 8);

statement ok
SET VARIABLE t1_files = (
  SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
  WHERE table_id = 1 AND end_snapshot IS NULL
);

statement ok
SET VARIABLE t3_files = (
  SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
  WHERE table_id = 3 AND end_snapshot IS NULL
);

statement ok con1
DELETE FROM __ducklake_metadata_lake.ducklake_data_file WHERE table_id = 2;

statement ok con1
COMMIT;

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
WHERE table_id = 2;
----
0

# Neither neighbour lost a file row.
query II
SELECT (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
        WHERE table_id = 1 AND end_snapshot IS NULL) = getvariable('t1_files'),
       (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
        WHERE table_id = 3 AND end_snapshot IS NULL) = getvariable('t3_files');
----
true	true

# t2 lost its files and reads empty; its neighbours read every row they
# were given, which a row id resolved against another table's run would
# have taken from them. Summed rather than counted, so the answer comes
# from the files rather than from the record counts in the statistics.
query III
SELECT (SELECT coalesce(sum(a), 0) FROM lake.main.t1),
       (SELECT coalesce(sum(a), 0) FROM lake.main.t2),
       (SELECT coalesce(sum(a), 0) FROM lake.main.t3);
----
18	0	11

# The third narrowing a scan can carry: `end_snapshot IS NULL` keeps only
# the unended versions, so the scan reads `current` and leaves `history`
# unread. A DML carrying it emits row ids, so its rows are resolved back
# from the run that narrowed scan registered — against the live versions
# it actually emitted, never the ended ones it never saw.
#
# History has to exist for the two lists to differ, which is what makes
# this adversarial: a resolution against the whole list would name an
# ended version at the positions the narrowed one gave out.
statement ok
CREATE TABLE lake.main.h1(a BIGINT, k BIGINT);

statement ok
CREATE TABLE lake.main.h2(a BIGINT, k BIGINT);

# Two inserts, so h1 owns two files and one can be retired without
# emptying the table.
statement ok
INSERT INTO lake.main.h1 VALUES (1, 1);

statement ok
INSERT INTO lake.main.h1 VALUES (2, 2);

statement ok
INSERT INTO lake.main.h2 VALUES (3, 3);

# A delete covering a whole file drops the file rather than writing a
# deletion beside it, which ends its row: h1 now has versions in both
# halves. (An `UPDATE` would not — it writes a delete file and leaves the
# data file's row live.)
statement ok
DELETE FROM lake.main.h1 WHERE a = 1;

query IT
SELECT table_id, table_name FROM __ducklake_metadata_lake.ducklake_table
WHERE table_name IN ('h1', 'h2') AND end_snapshot IS NULL ORDER BY table_id;
----
4	h1
5	h2

# Both halves are populated, or the test below proves nothing.
query II
SELECT count(*) FILTER (WHERE end_snapshot IS NULL) > 0,
       count(*) FILTER (WHERE end_snapshot IS NOT NULL) > 0
FROM __ducklake_metadata_lake.ducklake_data_file WHERE table_id = 4;
----
true	true

statement ok
SET VARIABLE h1_ended = (
  SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
  WHERE table_id = 4 AND end_snapshot IS NOT NULL
);

statement ok con1
BEGIN;

# Stage first, so the narrowed read below goes through the staged
# transaction — the shape a flush takes, and the only one where the
# narrowing engages.
statement ok con1
DELETE FROM __ducklake_metadata_lake.ducklake_file_column_stats WHERE table_id = 5;

# The adversarial statement: narrowed to h1's live versions, emitting row
# ids, resolved back through the run it registered.
statement ok con1
DELETE FROM __ducklake_metadata_lake.ducklake_data_file
WHERE end_snapshot IS NULL AND table_id = 4;

statement ok con1
COMMIT;

# Exactly the live versions went. The ended ones are untouched, which is
# what a row id resolved against the whole list would have taken instead.
query II
SELECT (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
        WHERE table_id = 4 AND end_snapshot IS NULL),
       (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
        WHERE table_id = 4 AND end_snapshot IS NOT NULL) = getvariable('h1_ended');
----
0	true

# And the neighbour table kept every file it had.
query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
WHERE table_id = 5 AND end_snapshot IS NULL;
----
1
