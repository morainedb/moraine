# Rust
/target
/dist
**/*.rs.bk
*.pdb

# DuckDB extension toolchain build output
/build
/.cache

# Fuzzing. `fuzz/` is its own workspace, so the root `/target` rule above
# does not reach its build tree. The corpus and any crash artifacts are
# machine-generated: a reproducing input belongs in an issue, not the tree.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# macOS
.DS_Store

# ClickBench entry: env.sh and the lake are build output, and the suite
# itself is staged in from a ClickBench checkout — it is CC BY-NC-SA and
# must not land in this tree.
/benchmark/clickbench/env.sh
/benchmark/clickbench/catalog
/benchmark/clickbench/data
/benchmark/clickbench/create.sql
/benchmark/clickbench/queries.sql
/benchmark/clickbench/hits.parquet
/benchmark/clickbench/result.csv

# Project
/docs/plans

# Benchmark infrastructure: provider downloads, and state, which holds the
# generated database password in clear text. `.terraform.lock.hcl` is
# committed.
/benchmark/infra/.terraform
/benchmark/infra/*.tfstate
/benchmark/infra/*.tfstate.*
/benchmark/infra/*.tfvars
/benchmark/infra/.terraform.tfstate.lock.info
/benchmark/infra/tfplan
