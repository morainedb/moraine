---
// Nova's header, laid out like Starlight's own: the search sits at the start
// of the content column, and the social links are grouped and divided from
// the theme toggle.
const { hasSidebar } = Astro.locals.starlightRoute;

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import MobileMenuToggle from 'starlight-theme-nova/components/MobileMenuToggle.astro';
---

<div class="header">
	<div class="title-wrapper">
		<SiteTitle />
	</div>
	<div class="search">
		<Search />
	</div>
	<div class="right-group">
		<div class="social">
			<SocialIcons />
		</div>
		<LanguageSelect />
		<ThemeSelect />
	</div>
	{
		hasSidebar && (
			<div class="mobile-toggle">
				<MobileMenuToggle />
			</div>
		)
	}
</div>

<style>
	.header {
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 100%;
	}

	.title-wrapper {
		/* Keep long titles from covering the search and menu buttons on
		   narrow viewports, without clipping the focus ring. */
		display: flex;
		min-width: 0;
		margin: -0.75rem;
		padding: 0.75rem;
		overflow: clip;
	}

	.search {
		display: flex;
		flex: 1;
		justify-content: flex-end;
	}

	.right-group,
	.social {
		display: none;
	}

	.mobile-toggle {
		display: flex;
		align-items: center;
	}

	@media (min-width: 50rem) {
		.header {
			display: grid;
			grid-template-columns: max(0px, calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x))) 1fr auto;
			column-gap: 1rem;
		}

		.search {
			justify-content: flex-start;
		}

		.search :global(site-search) {
			width: 100%;
			max-width: 22rem;
		}

		.right-group,
		.social {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.right-group {
			gap: 0.75rem;
		}

		.social::after {
			content: '';
			height: 1.5rem;
			border-inline-end: 1px solid var(--sl-color-hairline);
			margin-inline-start: 0.25rem;
		}

		.mobile-toggle {
			display: none;
		}
	}

	@media print {
		.search,
		.right-group,
		.mobile-toggle {
			display: none;
		}
	}
</style>
